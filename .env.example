# Canonical origin for a production deployment; use your own HTTPS domain if self-hosting.
NEXT_PUBLIC_SITE_URL=https://launcher.astrabrew.cn

# Optional: set to vercel or cloudflare only on the matching trusted platform.
GEO_PROVIDER=

# Optional: the site token from Cloudflare Web Analytics (manual snippet mode).
# Keep blank when Cloudflare already injects its beacon automatically.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
